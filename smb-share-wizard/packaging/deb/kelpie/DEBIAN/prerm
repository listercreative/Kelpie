#!/bin/sh
set -e

# Only for a genuine removal, never install.sh's own reinstall/upgrade
# cycle (which does an explicit `apt-get remove` internally, indistinguishable
# from a real uninstall otherwise - see install.sh's KELPIE_REINSTALLING).
# Runs in prerm, not postrm: the package's files (including core.py, which
# this needs to import) still exist at this point - by postrm they'd
# already be gone.
if { [ "$1" = "remove" ] || [ "$1" = "purge" ]; } && [ -z "$KELPIE_REINSTALLING" ]; then
    if command -v python3 >/dev/null 2>&1 && [ -f /usr/lib/kelpie/core.py ] && ( : < /dev/tty ) 2>/dev/null; then
        python3 - < /dev/tty > /dev/tty 2> /dev/tty <<'PYEOF' || true
import shutil
import sys
sys.path.insert(0, '/usr/lib/kelpie')
from core import SMBWizard

w = SMBWizard()
# Only shares carrying Kelpie's own group-naming signature - a share
# Kelpie didn't create (pre-existing, or made through some other tool)
# should never be touched here.
shares = [
    s for s in w.list_shares()
    if s.get('group') and (s['group'].startswith('smbshare_') or s['group'].startswith('kelpie_')) and s.get('path')
]

if shares:
    print()
    print("=== Kelpie shares still configured ===")
    for s in shares:
        print(f"  {s['name']} -> {s['path']}")
    print()
    answer = input("Delete these folders and everything in them? This cannot be undone. [y/N] ").strip().lower()
    if answer in ('y', 'yes'):
        for s in shares:
            ok, message = w.check_share_path(s['path'])
            if not ok:
                print(f"Skipped '{s['path']}': {message}")
                continue
            try:
                shutil.rmtree(s['path'])
                print(f"Deleted: {s['path']}")
            except Exception as e:
                print(f"Failed to delete '{s['path']}': {e}")
PYEOF
    fi
fi

exit 0
